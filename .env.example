# LOCAL-ONLY Docker database credentials. Do not reuse in production.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/eema
SPRING_DATASOURCE_USERNAME=eema
SPRING_DATASOURCE_PASSWORD=eema

# LOCAL-ONLY JWT signing secret. Production must supply a unique strong secret.
JWT_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LTMyaA==

# Local storage (Docker Compose development only)
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads
DOCUMENT_STORAGE_DIR=/app/private-documents
FILE_URL_PREFIX=/api/upload/files/
MAX_UPLOAD_FILE_SIZE_BYTES=5242880

# Production S3-compatible storage (do not commit real credentials)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC_MEDIA=
S3_BUCKET_PRIVATE_DOCUMENTS=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bounded background execution
ASYNC_CORE_POOL_SIZE=2
ASYNC_MAX_POOL_SIZE=4
ASYNC_QUEUE_CAPACITY=100
SCHEDULER_POOL_SIZE=2

# Admin emails
ADMIN_EMAIL_ALLOWLIST=your@email.com

# Mollie TEST credentials only. Leave the webhook blank for manual webhook testing,
# or set an HTTPS public-tunnel URL for automatic callbacks.
MOLLIE_API_KEY=
MOLLIE_REDIRECT_URL=http://localhost:3000/booked
MOLLIE_WEBHOOK_URL=
MOLLIE_REPORTING_ACCESS_TOKEN=
MOLLIE_FEE_RECONCILIATION_ENABLED=false
MOLLIE_FEE_RECONCILIATION_DELAY_MS=3600000
MOLLIE_FEE_RECONCILIATION_INITIAL_DELAY_MS=60000

# AI (optional unless matching is being tested)
GEMINI_API_KEY=

# Transactional email (disabled by default for local development)
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@eema.local
APP_FRONTEND_BASE_URL=http://localhost:3000

# Request-to-book: accepted requests expire if unpaid after this window.
BOOKING_PAYMENT_WINDOW_HOURS=24
BOOKING_EXPIRATION_SCAN_DELAY_MS=60000
# Workflow observability thresholds
WORKFLOW_OBSERVABILITY_SCAN_DELAY_MS=300000
PAYMENT_CREATING_STUCK_MINUTES=60
REFUND_STUCK_MINUTES=1440
FEE_UNRECONCILED_MINUTES=1440
