# LOCAL-ONLY Docker database credentials. Do not reuse in production.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/eema
SPRING_DATASOURCE_USERNAME=eema
SPRING_DATASOURCE_PASSWORD=eema

# LOCAL-ONLY JWT signing secret. Production must supply a unique strong secret.
JWT_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LTMyaA==

# Uploads
UPLOAD_DIR=/app/uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin emails
ADMIN_EMAIL_ALLOWLIST=your@email.com

# Mollie TEST credentials only. Leave the webhook blank for manual webhook testing,
# or set an HTTPS public-tunnel URL for automatic callbacks.
MOLLIE_API_KEY=
MOLLIE_REDIRECT_URL=http://localhost:3000/booked
MOLLIE_WEBHOOK_URL=
MOLLIE_REPORTING_ACCESS_TOKEN=
MOLLIE_FEE_RECONCILIATION_ENABLED=false
MOLLIE_FEE_RECONCILIATION_DELAY_MS=3600000
MOLLIE_FEE_RECONCILIATION_INITIAL_DELAY_MS=60000

# AI (optional unless matching is being tested)
GEMINI_API_KEY=

# Email (disabled for local development)
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@eema.local
