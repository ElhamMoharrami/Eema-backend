# Copy these names into the backend provider's encrypted environment settings.
# Never deploy this file and never commit real values.
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Managed PostgreSQL. Use the provider's TLS-validating JDBC URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://<staging-db-host>:5432/<staging-db>?sslmode=verify-full
SPRING_DATASOURCE_USERNAME=<staging-db-user>
SPRING_DATASOURCE_PASSWORD=<secret>

# Independent Base64 values containing at least 32 random bytes each.
JWT_SECRET=<base64-32-bytes-or-more>
PAYOUT_DESTINATIONS_ENABLED=true
PAYOUT_DATA_ENCRYPTION_KEY=<base64-32-bytes>
PAYOUT_DATA_FINGERPRINT_KEY=<different-base64-32-bytes>

# Replace the hostnames together. No localhost or wildcard origins.
APP_FRONTEND_BASE_URL=https://<staging-frontend-host>
CORS_ALLOWED_ORIGINS=https://<staging-frontend-host>

# Mollie TEST. Reporting uses a separate OAuth access token with balance-read access.
MOLLIE_API_KEY=test_<secret>
MOLLIE_REDIRECT_URL=https://<staging-frontend-host>/booked
MOLLIE_WEBHOOK_URL=https://<staging-api-host>/api/webhooks/mollie/payment
MOLLIE_REPORTING_ACCESS_TOKEN=<secret-or-empty-if-disabled>
MOLLIE_FEE_RECONCILIATION_ENABLED=false

# Resend staging sender on a verified domain.
EMAIL_NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=<secret>
RESEND_FROM_EMAIL=Eema Staging <staging@<verified-domain>>

# Matching. Leave empty only when deliberately rehearsing unavailable-AI behavior.
GEMINI_API_KEY=<secret>

# S3-compatible staging storage. Buckets must be different.
S3_ENDPOINT=https://<s3-compatible-endpoint>
S3_REGION=<region>
S3_BUCKET_PUBLIC_MEDIA=<staging-public-media-bucket>
S3_BUCKET_PRIVATE_DOCUMENTS=<staging-private-documents-bucket>
S3_ACCESS_KEY=<secret>
S3_SECRET_KEY=<secret>
S3_PATH_STYLE_ACCESS=false
FILE_URL_PREFIX=/api/upload/files/

# Controlled first-admin account; this does not create or promote an account.
ADMIN_EMAIL_ALLOWLIST=<dedicated-staging-admin-email>

# Operational defaults. Change only deliberately.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
SCHEDULER_POOL_SIZE=2
ASYNC_CORE_POOL_SIZE=2
ASYNC_MAX_POOL_SIZE=4
ASYNC_QUEUE_CAPACITY=100
MAX_UPLOAD_FILE_SIZE=5MB
MAX_UPLOAD_REQUEST_SIZE=6MB
MAX_UPLOAD_FILE_SIZE_BYTES=5242880
BOOKING_PAYMENT_WINDOW_HOURS=24
BOOKING_OWNER_RESPONSE_WINDOW_HOURS=24
BOOKING_EXPIRATION_SCAN_DELAY_MS=60000
AVAILABILITY_INQUIRY_OFFER_VALID_HOURS=48
AVAILABILITY_INQUIRY_EXPIRATION_SCAN_DELAY_MS=60000
PAYOUT_READINESS_SCAN_DELAY_MS=300000
WORKFLOW_OBSERVABILITY_SCAN_DELAY_MS=300000
PAYMENT_CREATING_STUCK_MINUTES=60
REFUND_STUCK_MINUTES=1440
FEE_UNRECONCILED_MINUTES=1440
PAYOUT_READY_OVERDUE_HOURS=72
